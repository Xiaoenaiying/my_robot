<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"  name="robot">
    <!--转动惯量-->
    <xacro:macro name="box_inertia" params="mass x y z o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <mass value="${mass}"/>
            <inertia ixx="${(mass/12)*(y*y+z*z)}" ixy="0" ixz="0" iyy="${(mass/12)*(x*x+z*z)}" iyz="0" izz="${(mass/12)*(x*x+y*y)}"/>
        </inertial>
    </xacro:macro>

    <xacro:macro name="Cylinder_inertia" params="mass R H o_xyz o_rpy">
        <inertial>
            <origin xyz="${o_xyz}" rpy="${o_rpy}"/>
            <mass value="${mass}"/>
            <inertia ixx="${(mass/12)*(3*R*R+H*H)}" ixy="0" ixz="0" iyy="${(mass/12)*(3*R*R+H*H)}" iyz="0" izz="${(mass/2)*R*R}"/>
        </inertial>
        
    </xacro:macro>